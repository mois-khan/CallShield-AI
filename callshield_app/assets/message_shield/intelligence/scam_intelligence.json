    "credential_theft": {
      "objectives": ["Steal authentication information (OTP / PIN / CVV / password)"],
      "actions": ["Never share OTP, PIN, CVV or passwords - not even with 'bank staff'", "Do not read a code out over a call", "Do not enter credentials on links that arrive by message"]
    },
    "impersonation": {
      "objectives": ["Pressure you using a fake authority", "Impersonate a bank, government or police officer"],
      "actions": ["Do not trust the claimed identity", "Verify only through the official app, website or printed helpline", "No government agency demands instant payment by UPI"]
    },
    "social_engineering": {
      "objectives": ["Panic you into acting before you verify"],
      "actions": ["Stop and speak to someone you trust first", "Do not send money from a message alone", "Call the person back on the number you already know"]
    },
    "investment_scam": {
      "objectives": ["Get you to invest or pay an upfront fee"],
      "actions": ["Never pay registration, training or processing fees for a job or loan", "No genuine scheme guarantees fixed daily returns", "Check SEBI / RBI / IRDAI registration before investing"]
    },
    "reward_scam": {
      "objectives": ["Make you pay a fee to 'release' a prize"],
      "actions": ["You cannot win a lottery you never entered", "Never pay a fee or tax to receive a prize", "Do not share bank details for a cashback"]
    },
    "delivery_scam": {
      "objectives": ["Collect a fake delivery, customs or redelivery fee"],
      "actions": ["Track the parcel only on the official courier app", "Customs duty is never collected over chat or UPI links", "Do not pay a redelivery fee to an unknown account"]
    },
    "extortion": {
      "objectives": ["Blackmail you with threats or private content"],
